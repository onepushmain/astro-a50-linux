#!/usr/bin/env bash
# Opens A50 Control: serves the app on 127.0.0.1 and shows it in a Chromium
# app window with its own profile (so the WebHID permission is remembered and
# kept apart from your normal browsing). The server stops when the window closes.
#
# Environment: ASTRO_A50_BROWSER (default chromium), ASTRO_A50_PORT (47850),
# ASTRO_A50_SHARE (directory with index.html).
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")

find_file() {
  local f
  for f in "$@"; do
    if [[ -e $f ]]; then readlink -f "$f"; return 0; fi
  done
  return 1
}

share=${ASTRO_A50_SHARE:-$(find_file "$here/../share/astro-a50/app" "$here/../app" || true)}
server_bin=$(find_file "$here/../lib/astro-a50/astro-a50-server" "$here/../libexec/astro-a50-server" || true)
if [[ -z $share || ! -f $share/index.html || -z $server_bin ]]; then
  echo "astro-a50: app files not found" >&2
  exit 1
fi

port=${ASTRO_A50_PORT:-47850}
browser=${ASTRO_A50_BROWSER:-chromium}
run_dir=${XDG_RUNTIME_DIR:-/tmp}/astro-a50
profile=${XDG_DATA_HOME:-$HOME/.local/share}/astro-a50/profile
pid_file=$run_dir/app.pid
server_pid_file=$run_dir/server.pid
url="http://127.0.0.1:$port/"
browser_args=(--user-data-dir="$profile" --app="$url" --class=astro-a50
  --no-first-run --no-default-browser-check --ozone-platform-hint=auto)

mkdir -p -m 700 "$run_dir"
if [[ ! -O $run_dir ]]; then
  echo "astro-a50: $run_dir belongs to another user" >&2
  exit 1
fi
mkdir -p "$profile"

alive() { [[ -f $1 ]] && kill -0 "$(cat "$1")" 2>/dev/null; }

# Already open: Chromium hands the new window to the running instance, and the
# page there sees the device is taken and says so.
if alive "$pid_file"; then
  exec "$browser" "${browser_args[@]}"
fi

# A launcher killed with SIGKILL leaves its server behind; stop it if it is ours.
if alive "$server_pid_file"; then
  stale=$(cat "$server_pid_file")
  if tr '\0' ' ' < "/proc/$stale/cmdline" 2>/dev/null | grep -q -- "astro-a50-server --port $port "; then
    kill "$stale" 2>/dev/null || true
    for _ in $(seq 30); do kill -0 "$stale" 2>/dev/null || break; sleep 0.1; done
  fi
fi
rm -f "$server_pid_file"

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; }

if port_open; then
  echo "astro-a50: port $port is in use by another program; pick another with ASTRO_A50_PORT" >&2
  exit 1
fi

# The waybar helper takes this lock before it talks to the device; holding it
# keeps the helper away while the window is open. Children don't inherit it.
exec {lock_fd}>"$run_dir/status.lock"
flock "$lock_fd"

python3 -I "$server_bin" --port "$port" --dir "$share" {lock_fd}>&- &
server=$!
echo "$server" > "$server_pid_file"

browser_pid=
cleanup() {
  [[ -n $browser_pid ]] && kill "$browser_pid" 2>/dev/null || true
  kill "$server" 2>/dev/null || true
  wait "$server" 2>/dev/null || true
  rm -f "$pid_file" "$server_pid_file"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

for _ in $(seq 50); do
  port_open && break
  if ! kill -0 "$server" 2>/dev/null; then
    echo "astro-a50: could not start the local server" >&2
    exit 1
  fi
  sleep 0.1
done

echo $$ > "$pid_file"
# In the background so INT/TERM are handled at once, not after the browser exits.
"$browser" "${browser_args[@]}" {lock_fd}>&- &
browser_pid=$!
wait "$browser_pid" || true
browser_pid=

# If Chromium was already running with this profile (opened outside this
# launcher), the command above returns at once; keep serving until it exits.
while pgrep -u "$(id -u)" -f -- "--user-data-dir=$profile( |$)" > /dev/null; do
  sleep 1
done
